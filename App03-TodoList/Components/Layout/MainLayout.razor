@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-center align-items-center" style="background-color: transparent; border-bottom: none;">
            <h3 class="m-0 text-dark fw-bold text-center w-100" style="padding-top: 1.5rem;">To-Do List Application</h3>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-enhance>
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>