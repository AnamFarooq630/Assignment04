@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-center align-items-center" style="background-color: #f8f9fa; border-bottom: 1px solid #e3e6f0;">
            <h4 class="m-0 text-dark fw-bold text-center w-100" style="color: #1e3a8a !important;">Interactive Counter App</h4>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-enhance>
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>