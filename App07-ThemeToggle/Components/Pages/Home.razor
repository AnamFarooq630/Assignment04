@page "/"

<PageTitle>Theme Persistence Hub</PageTitle>

<div class="central-container-wrapper">
    <div class="card shadow-lg border-0 main-theme-card">

        <div class="card-header text-white text-center py-4 px-3 brand-header">
            <h4 class="mb-2 fw-bold tracking-wide text-uppercase" style="font-size: 1.3rem; letter-spacing: 0.5px;">
                Application 07
            </h4>
            <p class="mb-0 opacity-80 small fw-medium">Persistent State Local Storage Engine</p>
        </div>

        <div class="card-body p-4 text-center d-flex flex-column gap-4">

            <div class="p-4 text-box-accent rounded border-start border-4 shadow-sm text-start">
                <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-center gap-2 description-title">
                    <i class="bi bi-shield-check fs-5"></i>
                    <span>State Synchronization</span>
                </h5>
                <p class="small mb-0 description-text lh-base text-center px-2">
                    Click the top-right button to change your view mode state. The application injects runtime client commands to make preferences persistent across active tabs and system restarts.
                </p>
            </div>

            <div class="status-footer pt-3 mt-2 border-top d-flex justify-content-center align-items-center gap-3">
                <span class="spinner-grow spinner-grow-sm text-success" role="status" style="width: 10px; height: 10px;"></span>
                <span class="engine-status-text fw-semibold tracking-wide text-uppercase">
                   
                </span>
            </div>

        </div>
    </div>
</div>