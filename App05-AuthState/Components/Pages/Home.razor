@page "/"
@rendermode InteractiveServer
@using App05_AuthState.Services
@inject AuthenticationStateService AuthGlobalService
@implements IDisposable

<PageTitle>User Authentication Service</PageTitle>

<div class="container mt-5 d-flex flex-column align-items-center">
    <div class="card shadow-sm border-0 w-100" style="max-width: 480px; border-radius: 12px; overflow: hidden;">

        <div class="card-header text-white text-center py-4" style="background-color: #4f46e5;">
            <h4 class="mb-0 fw-bold tracking-wide">Login Manager</h4>
        </div>

        <div class="card-body p-4 bg-white text-center">

            <div class="my-4 p-4 bg-light" style="border-radius: 8px; border-left: 4px solid @(AuthGlobalService.IsAuthenticated ? "#10b981" : "#ef4444");">
                @if (AuthGlobalService.IsAuthenticated)
                {
                    <h4 class="fw-bold mb-1" style="color: #10b981;">Welcome Back!</h4>
                    <p class="text-muted small mb-0">Authorized session is currently active.</p>
                }
                else
                {
                    <h4 class="fw-bold mb-1" style="color: #ef4444;">Access Restricted</h4>
                    <p class="text-muted small mb-0">Please sign in to view your user profile.</p>
                }
            </div>

            <div class="mt-4">
                @if (!AuthGlobalService.IsAuthenticated)
                {
                    <button class="btn text-white btn-lg w-100 py-2 fw-semibold btn-theme-action" @onclick="HandleLogIn" style="background-color: #4f46e5; border-radius: 8px;">
                        Log In
                    </button>
                }
                else
                {
                    <button class="btn btn-danger btn-lg w-100 py-2 fw-semibold" @onclick="HandleLogOut" style="background-color: #ef4444; border-radius: 8px;">
                        Log Out
                    </button>
                }
            </div>

        </div>
    </div>
</div>

<style>
    .btn-theme-action {
        transition: all 0.2s ease;
    }

        .btn-theme-action:hover {
            background-color: #4338ca !important;
            transform: translateY(-1px);
        }
</style>

@code {
    protected override void OnInitialized()
    {
        AuthGlobalService.OnStateChanged += HandleStateChanged;
    }

    private void HandleLogIn()
    {
        AuthGlobalService.LogIn();
    }

    private void HandleLogOut()
    {
        AuthGlobalService.LogOut();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthGlobalService.OnStateChanged -= HandleStateChanged;
    }
}