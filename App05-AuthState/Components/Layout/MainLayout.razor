@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar" style="background-image: linear-gradient(180deg, #4f46e5 0%, #3730a3 100%);">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-center align-items-center" style="background-color: #f3f4f6; border-bottom: 1px solid #e5e7eb;">
            <h5 class="m-0 fw-bold text-center w-100" style="color: #4f46e5 !important;">
                State Management Service
            </h5>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>